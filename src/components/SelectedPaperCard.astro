---
import type { Publication } from '../lib/collections';
import { venueBadge, venueAccent, venueLogo } from '../lib/authors';

interface Props {
  pub: Publication;
}
const { pub } = Astro.props;

const badge = venueBadge(pub.venue);
const accent = venueAccent(pub.venue);
const logo = venueLogo(pub.venue);
const authors = pub.authors.map((a, i) => ({
  name: a.name,
  group: !!a.group,
  corr: !!a.corresponding,
  href: a.memberId ? `/people#${a.memberId}` : null,
  sep: i < pub.authors.length - 1 ? ', ' : '',
}));
---

<article class="sp" style={`--accent:${accent}`}>
  <div class="sp__top">
    {
      logo ? (
        <span class="sp__logo">
          <img src={logo} alt={pub.venue} />
        </span>
      ) : (
        <span class="sp__badge">{badge}</span>
      )
    }
    <span class="sp__year">{pub.year}</span>
  </div>

  <a class="sp__title" href={pub.url} target="_blank" rel="noopener">{pub.title}</a>

  <p class="sp__authors">
    {
      authors.map((a) => (
        <span>
          {a.href ? (
            <a class:list={['sp__name', { 'sp__name--g': a.group }]} href={a.href}>
              {a.name}
            </a>
          ) : (
            <span class:list={['sp__name', { 'sp__name--g': a.group }]}>{a.name}</span>
          )}
          {a.corr && <span class="sp__corr">∗</span>}
          {a.sep}
        </span>
      ))
    }
  </p>

  <div class="sp__cite">{pub.citation}</div>
</article>

<style>
  .sp {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--pane);
    border: 1px solid var(--soft);
    border-top: 3px solid var(--accent);
    border-radius: var(--radius-card);
    padding: 20px 24px 22px;
    transition: border-color 0.15s ease;
  }
  .sp:hover {
    border-color: color-mix(in srgb, var(--accent) 45%, var(--soft));
    border-top-color: var(--accent);
  }
  .sp__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 14px;
  }

  /* uniform logo tile — every journal logo the same height, on a white chip so
     it stays legible in both light and dark themes */
  .sp__logo {
    display: inline-flex;
    align-items: center;
    height: 34px;
    padding: 0 11px;
    background: #fff;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 3px;
  }
  .sp__logo img {
    height: 20px;
    width: auto;
    display: block;
  }

  .sp__badge {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: #fff;
    background: var(--accent);
    padding: 6px 10px;
    border-radius: 2px;
  }
  .sp__year {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--muted);
  }
  .sp__title {
    font-family: var(--font-serif);
    font-size: 22px;
    line-height: 1.3;
    letter-spacing: -0.003em;
    color: var(--ink);
    text-wrap: pretty;
  }
  .sp__title:hover {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .sp__authors {
    margin: 12px 0 0;
    font-family: var(--font-display);
    font-size: 14px;
    line-height: 1.6;
    color: var(--muted);
    text-wrap: pretty;
  }
  .sp__name--g {
    color: var(--ink);
    font-weight: 600;
  }
  a.sp__name--g:hover {
    color: var(--accent);
  }
  .sp__corr {
    color: var(--core);
  }
  .sp__cite {
    margin-top: auto;
    padding-top: 16px;
    font-family: var(--font-mono);
    font-size: 14.5px;
    font-weight: 600;
    color: var(--ink);
  }
</style>
