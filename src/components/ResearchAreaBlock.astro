---
import type { AreaTag } from '../lib/collections';
import { publicAssetExists } from '../lib/assets';
import Placeholder from './Placeholder.astro';
import Fringe from './Fringe.astro';

interface Props {
  area: AreaTag;
  paperCount: number;
  figureLeft?: boolean;
}
const { area, paperCount, figureLeft = true } = Astro.props;

const hasFigure = publicAssetExists(area.figure);
const figureName = area.figure.split('/').pop();
const seeAll = `/publications?tag=${area.id}`;
---

<section class:list={['area', figureLeft ? 'area--fig-left' : 'area--fig-right']}>
  <div class="area__figure">
    {
      hasFigure ? (
        <img src={area.figure} alt={area.figureAlt} loading="lazy" />
      ) : (
        <Placeholder variant="figure" ratio="4 / 3" label={`figure — ${figureName}`} />
      )
    }
  </div>

  <div class="area__text">
    <h2 class="area__title">{area.label}</h2>
    <p class="area__tagline">{area.tagline}</p>
    <p class="area__desc">{area.description}</p>
    <div class="area__foot">
      <Fringe count={paperCount} label={`${paperCount} papers in ${area.label}`} h={14} />
      <a class="area__link" href={seeAll}>See all papers →</a>
    </div>
  </div>
</section>

<style>
  .area {
    border-top: 1px solid var(--rule);
    padding: 36px 0;
    display: grid;
    grid-template-columns: 420px 1fr;
    gap: 56px;
    align-items: start;
  }
  .area--fig-right {
    grid-template-columns: 1fr 420px;
  }
  .area--fig-right .area__figure {
    order: 2;
  }

  .area__figure img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
  }

  .area__title {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(24px, 4vw, 30px);
    font-weight: 400;
    line-height: 1.15;
  }
  .area__tagline {
    margin: 14px 0 0;
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 300;
    line-height: 1.45;
    color: var(--cyan);
    max-width: 44ch;
    text-wrap: pretty;
  }
  .area__desc {
    margin: 18px 0 0;
    font-size: 14.5px;
    line-height: 1.7;
    color: color-mix(in srgb, var(--ink) 78%, var(--ground));
    max-width: 62ch;
    text-wrap: pretty;
  }
  .area__foot {
    margin-top: 24px;
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }
  .area__link {
    font-family: var(--font-display);
    font-size: 14px;
    color: var(--cyan);
    border-bottom: 1px solid color-mix(in srgb, var(--cyan) 40%, transparent);
    padding-bottom: 2px;
  }
  .area__link:hover {
    border-color: var(--cyan);
  }

  @media (max-width: 820px) {
    .area,
    .area--fig-right {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .area--fig-right .area__figure {
      order: 0;
    }
  }
</style>
