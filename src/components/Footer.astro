---
import Wordmark from './Wordmark.astro';
import { getMembers } from '../lib/collections';

// Contact details come from the PI's record — no hardcoded email to drift.
const members = await getMembers();
const pi = members.find((m) => m.role === 'pi');
const primary = pi?.emails.find((e) => e.primary) ?? pi?.emails[0];
const email = primary ? `${primary.user}@${primary.domain}` : null;

const elsewhere = [
  pi?.links.scholar ? { label: 'Google Scholar', href: pi.links.scholar } : null,
  pi?.links.website ? { label: 'PI website', href: pi.links.website } : null,
  { label: 'KAIST Physics', href: 'https://physics.kaist.ac.kr/' },
].filter((x): x is { label: string; href: string } => x !== null);

const year = new Date().getFullYear();
---

<footer class="ft">
  <div class="wrap ft__grid">
    <div class="ft__brand">
      <Wordmark h={18} />
      <div class="ft__name">Quantum Information Theory</div>
      <address class="ft__addr">
        Department of Physics, KAIST<br />
        291 Daehak-ro, Yuseong-gu<br />
        Daejeon 34141, Republic of Korea
      </address>
    </div>

    <div>
      <div class="ft__label">Contact</div>
      {email && <a class="ft__email" href={`mailto:${email}`}>{email}</a>}
      <div class="ft__openings">
        <a href="/join">Openings →</a>
      </div>
    </div>

    <div>
      <div class="ft__label">Elsewhere</div>
      <div class="ft__links">
        {
          elsewhere.map((l) => (
            <a href={l.href} target="_blank" rel="noopener">
              {l.label} ↗
            </a>
          ))
        }
      </div>
    </div>
  </div>

  <div class="wrap ft__base">
    <span>© {year} QIT Group</span>
    <span>Est. April 2024</span>
  </div>
</footer>

<style>
  .ft {
    margin-top: 88px;
  }
  .ft__grid {
    border-top: 1px solid var(--rule);
    padding-top: 32px;
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: 40px;
  }
  .ft__name {
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 500;
    color: var(--ink);
    margin-top: 16px;
  }
  .ft__addr {
    font-style: normal;
    font-size: 13px;
    line-height: 1.6;
    color: var(--muted);
    margin-top: 6px;
  }
  .ft__label {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 10px;
  }
  .ft__email {
    font-family: var(--font-mono);
    font-size: 11.5px;
    border-bottom: 1px solid color-mix(in srgb, var(--cyan) 45%, transparent);
    padding-bottom: 1px;
    overflow-wrap: anywhere;
  }
  .ft__openings {
    margin-top: 14px;
  }
  .ft__openings a {
    font-family: var(--font-display);
    font-size: 13px;
    border-bottom: 1px solid color-mix(in srgb, var(--cyan) 45%, transparent);
    padding-bottom: 1px;
  }
  .ft__links {
    display: flex;
    flex-direction: column;
    gap: 7px;
  }
  .ft__links a {
    font-family: var(--font-display);
    font-size: 13px;
    color: var(--ink);
    opacity: 0.78;
  }
  .ft__links a:hover {
    opacity: 1;
    color: var(--cyan);
  }
  .ft__base {
    margin-top: 28px;
    padding-top: 16px;
    padding-bottom: 32px;
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--muted);
    border-top: 1px solid var(--soft);
  }

  @media (max-width: 820px) {
    .ft__grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }
</style>
