---
// Single site-wide footer: a bold "Location" title and the address.
---

<footer class="ft">
  <div class="wrap ft__inner">
    <h2 class="ft__title">Location</h2>
    <address class="ft__addr">
      Department of Physics in KAIST<br />
      KAIST KI building (E4) A321 (Professor's office), A322 and A323 (Students' office)<br />
      291 Daehak-ro, Yuseong-gu, Daejeon 34141, South Korea
    </address>
  </div>
</footer>

<style>
  .ft {
    margin-top: clamp(64px, 10vw, 96px);
    border-top: 1px solid var(--rule);
  }
  .ft__inner {
    padding-block: clamp(32px, 5vw, 48px);
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .ft__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 600;
    color: var(--ink);
  }
  .ft__addr {
    font-style: normal;
    font-size: 14px;
    line-height: 1.7;
    color: var(--muted);
    max-width: 74ch;
  }
</style>
