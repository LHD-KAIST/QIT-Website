---
// Shared page header: a large STIX title with a single sentence aligned to its
// lower right, leaving deliberate whitespace above. Every inner page breathes
// the same way (design board 5).
interface Props {
  title: string;
  lead?: string;
  eyebrow?: string;
}
const { title, lead, eyebrow } = Astro.props;
---

<header class="ph-head wrap">
  <div class="ph-head__main">
    {eyebrow && <div class="ph-head__eyebrow">{eyebrow}</div>}
    <h1 class="ph-head__title">{title}</h1>
  </div>
  {lead && <p class="ph-head__lead">{lead}</p>}
</header>

<style>
  .ph-head {
    padding-top: clamp(56px, 9vw, 96px);
    padding-bottom: 28px;
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: 56px;
    align-items: end;
    border-bottom: 1px solid var(--rule);
  }
  .ph-head__eyebrow {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 16px;
  }
  .ph-head__title {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(34px, 6vw, 46px);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.012em;
  }
  .ph-head__lead {
    margin: 0;
    font-size: 14px;
    line-height: 1.65;
    color: var(--muted);
    text-wrap: pretty;
  }

  @media (max-width: 820px) {
    .ph-head {
      grid-template-columns: 1fr;
      gap: 20px;
      align-items: start;
    }
  }
</style>
