---
// The wordmark is not a logo but seven interference fringes — bright Core bar
// at the centre, cyan bars fading outward (derived from reference ① concentric
// orbits). Purely decorative; the accessible name lives on the link in Nav/Footer.
interface Props {
  h?: number;
}
const { h = 22 } = Astro.props;

const bars = [
  { f: 0.32, w: 1, op: 0.35 },
  { f: 0.55, w: 1, op: 0.55 },
  { f: 0.82, w: 1, op: 0.8 },
  { f: 1, w: 2, core: true },
  { f: 0.82, w: 1, op: 0.8 },
  { f: 0.55, w: 1, op: 0.55 },
  { f: 0.32, w: 1, op: 0.35 },
];
---

<span class="mark" aria-hidden="true" style={`height:${h}px`}>
  {
    bars.map((b) => (
      <span
        style={`width:${b.w}px;height:${Math.round(b.f * h)}px;background:${
          b.core ? 'var(--core)' : 'var(--cyan)'
        };${b.core ? '' : `opacity:${b.op};`}`}
      />
    ))
  }
</span>

<style>
  .mark {
    display: inline-flex;
    gap: 2px;
    align-items: center;
    flex: none;
  }
  .mark > span {
    display: block;
  }
</style>
