---
// The signature element. N one-pixel ticks = N papers. Density stands in for a
// number we never print (brief §2, §5.6). Decorative marks are aria-hidden;
// the `label` carries the real fact to screen readers ("15 papers in 2026").
interface Props {
  count: number;
  label: string;
  h?: number;
  class?: string;
}
const { count, label, h = 18, class: className } = Astro.props;
---

<span class:list={['fringe', className]} style={`--fringe-h:${h}px`}>
  <span class="ticks" aria-hidden="true">
    {Array.from({ length: count }).map(() => <span class="tick" />)}
  </span>
  <span class="sr-only">{label}</span>
</span>

<style>
  .fringe {
    display: inline-flex;
    align-items: flex-end;
  }
  .ticks {
    display: inline-flex;
    gap: 3px;
    align-items: flex-end;
  }
  .tick {
    width: 1px;
    height: var(--fringe-h);
    background: var(--cyan);
    display: block;
  }
</style>
