---
/**
 * Shared shell for the self-hosted admin tools (/admin, /admin/member,
 * /admin/paper). These pages are plain static pages: the lists render public
 * repo data, and every "edit"/"create" action deep-links to github.com, where
 * GitHub handles sign-in and enforces write access. No credentials or tokens
 * are ever handled here — the pages are public, but only repo collaborators can
 * actually commit a change.
 */
interface Props {
  title: string;
  active?: 'home' | 'member' | 'paper';
}
const { title, active } = Astro.props;

const REPO = 'LHD-KAIST/QIT-Website';
const BRANCH = 'main';

const NAV = [
  { key: 'home', label: 'Home', href: '/admin' },
  { key: 'member', label: 'Members', href: '/admin/member' },
  { key: 'paper', label: 'Papers', href: '/admin/paper' },
] as const;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title} — QIT admin</title>
  </head>
  <body>
    <header class="topbar">
      <div class="topbar-inner">
        <a class="brand" href="/admin">QIT admin</a>
        <nav>
          {
            NAV.map((n) => (
              <a href={n.href} class={active === n.key ? 'nav-link active' : 'nav-link'}>
                {n.label}
              </a>
            ))
          }
        </nav>
        <div class="auth" id="authArea">
          <span class="auth-status" id="authStatus" hidden></span>
          <button id="signInBtn" type="button" class="auth-btn">Sign in with GitHub</button>
          <button id="signOutBtn" type="button" class="auth-btn ghost" hidden>Sign out</button>
        </div>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>

    <script define:vars={{ REPO, BRANCH }}>
      // Shared admin auth + GitHub write helper. Editing pages call
      // window.qitAdmin.saveFile(...) which signs in on demand (GitHub OAuth
      // popup, handled by /auth + /callback) and commits straight to the repo
      // via the GitHub Contents API. The client secret never leaves Cloudflare;
      // GitHub enforces that only repo collaborators can actually write.
      (function () {
        const API = 'https://api.github.com';
        const KEY = 'qit_gh_token';
        const listeners = [];

        const getToken = () => sessionStorage.getItem(KEY) || null;
        function setToken(t) {
          if (t) sessionStorage.setItem(KEY, t);
          else sessionStorage.removeItem(KEY);
          renderAuth();
          listeners.forEach((fn) => fn(getToken()));
        }

        function signIn() {
          return new Promise((resolve, reject) => {
            const w = 640,
              h = 720;
            const left = window.screenX + (window.outerWidth - w) / 2;
            const top = window.screenY + (window.outerHeight - h) / 2;
            const popup = window.open(
              '/auth',
              'gh-oauth',
              `width=${w},height=${h},left=${left},top=${top}`,
            );
            if (!popup) return reject(new Error('Popup blocked — allow popups and retry.'));
            function onMsg(e) {
              if (typeof e.data !== 'string') return;
              if (e.data.indexOf('authorizing:github') === 0) {
                // handshake: reply so the popup sends the token back
                popup.postMessage('authorizing:github', '*');
                return;
              }
              const m = e.data.match(/^authorization:github:(success|error):([\s\S]+)$/);
              if (!m) return;
              window.removeEventListener('message', onMsg);
              try {
                popup.close();
              } catch (_) {}
              let data = {};
              try {
                data = JSON.parse(m[2]);
              } catch (_) {}
              if (m[1] === 'success' && data.token) {
                setToken(data.token);
                resolve(data.token);
              } else {
                reject(new Error(data.error || 'Sign-in failed.'));
              }
            }
            window.addEventListener('message', onMsg);
          });
        }

        function authHeaders() {
          return {
            Authorization: 'Bearer ' + getToken(),
            Accept: 'application/vnd.github+json',
            'X-GitHub-Api-Version': '2022-11-28',
          };
        }
        function b64(str) {
          const bytes = new TextEncoder().encode(str);
          let bin = '';
          for (let i = 0; i < bytes.length; i++) bin += String.fromCharCode(bytes[i]);
          return btoa(bin);
        }

        async function getSha(path) {
          const r = await fetch(
            `${API}/repos/${REPO}/contents/${encodeURIComponent(path).replace(/%2F/g, '/')}?ref=${BRANCH}`,
            { headers: authHeaders() },
          );
          if (r.status === 404) return null;
          if (!r.ok) throw new Error('Could not read file (' + r.status + ').');
          return (await r.json()).sha;
        }

        // Create or update `path` with `content`, committing to the repo.
        async function saveFile({ path, content, message }) {
          if (!getToken()) await signIn();
          const sha = await getSha(path);
          const body = { message, content: b64(content), branch: BRANCH };
          if (sha) body.sha = sha;
          const r = await fetch(
            `${API}/repos/${REPO}/contents/${encodeURIComponent(path).replace(/%2F/g, '/')}`,
            { method: 'PUT', headers: { ...authHeaders(), 'Content-Type': 'application/json' }, body: JSON.stringify(body) },
          );
          if (!r.ok) {
            const e = await r.json().catch(() => ({}));
            throw new Error(e.message || 'Save failed (' + r.status + ').');
          }
          return { ...(await r.json()), created: !sha };
        }

        // --- topbar UI ---
        const $ = (id) => document.getElementById(id);
        function renderAuth() {
          const on = !!getToken();
          $('signInBtn').hidden = on;
          $('signOutBtn').hidden = !on;
          const st = $('authStatus');
          st.hidden = !on;
          if (on) st.textContent = 'Signed in';
        }
        $('signInBtn').addEventListener('click', () => signIn().catch((e) => alert(e.message)));
        $('signOutBtn').addEventListener('click', () => setToken(null));
        renderAuth();

        window.qitAdmin = { REPO, BRANCH, getToken, signIn, signOut: () => setToken(null), saveFile, onAuthChange: (fn) => listeners.push(fn) };
      })();
    </script>

    <style is:global>
      :root {
        --bg: #ecf0f1;
        --surface: #fff;
        --border: #c9d3d5;
        --ink: #121719;
        --ink-soft: #5c6b70;
        --accent: #145661;
        --accent-dark: #0e3d45;
      }
      * {
        box-sizing: border-box;
      }
      body {
        font-family: system-ui, -apple-system, sans-serif;
        color: var(--ink);
        background: var(--bg);
        margin: 0;
      }

      /* --- top navigation ---------------------------------------------------- */
      .topbar {
        background: var(--accent);
        color: #fff;
      }
      .topbar-inner {
        max-width: 860px;
        margin: 0 auto;
        padding: 0 24px;
        display: flex;
        align-items: center;
        gap: 24px;
        height: 52px;
      }
      .brand {
        font-weight: 700;
        font-size: 15px;
        color: #fff;
        text-decoration: none;
        letter-spacing: 0.02em;
      }
      .topbar nav {
        display: flex;
        gap: 4px;
      }
      .nav-link {
        color: #cfe3e6;
        text-decoration: none;
        font-size: 14px;
        padding: 6px 12px;
        border-radius: 4px;
      }
      .nav-link:hover {
        background: rgba(255, 255, 255, 0.12);
        color: #fff;
      }
      .nav-link.active {
        background: rgba(255, 255, 255, 0.18);
        color: #fff;
        font-weight: 600;
      }
      .auth {
        margin-left: auto;
        display: flex;
        align-items: center;
        gap: 10px;
      }
      .auth-status {
        font-size: 12.5px;
        color: #bfe0d6;
      }
      .auth-status::before {
        content: '● ';
        color: #7fe0b0;
      }
      .auth-btn {
        padding: 6px 12px;
        font-size: 13px;
        border-radius: 4px;
        border: 1px solid rgba(255, 255, 255, 0.55);
        background: transparent;
        color: #fff;
        cursor: pointer;
      }
      .auth-btn:hover {
        background: rgba(255, 255, 255, 0.14);
      }
      .auth-btn.ghost {
        border-color: rgba(255, 255, 255, 0.3);
        color: #cfe3e6;
      }

      /* --- page shell -------------------------------------------------------- */
      .wrap {
        max-width: 860px;
        margin: 0 auto;
        padding: 32px 24px 80px;
      }
      h1 {
        font-size: 28px;
        margin: 0 0 8px;
      }
      h2 {
        font-size: 18px;
        margin: 32px 0 12px;
        padding-bottom: 6px;
        border-bottom: 1px solid var(--border);
      }
      .note {
        color: var(--ink-soft);
        font-size: 12.5px;
        margin: 4px 0 8px;
      }
      .steps {
        color: #1c2427;
        line-height: 1.7;
        font-size: 15px;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 6px;
        padding: 16px 20px 16px 40px;
        margin: 8px 0;
      }
      .steps li {
        margin-bottom: 6px;
      }

      /* --- forms ------------------------------------------------------------- */
      .row {
        display: flex;
        gap: 10px;
        margin: 12px 0;
        flex-wrap: wrap;
      }
      input[type='text'],
      input[type='number'],
      input[type='email'],
      select {
        padding: 8px 10px;
        border: 1px solid var(--border);
        border-radius: 3px;
        font-size: 14px;
        background: var(--surface);
        color: var(--ink);
      }
      button {
        padding: 9px 16px;
        border: 1px solid var(--accent);
        background: var(--surface);
        color: var(--accent);
        border-radius: 3px;
        cursor: pointer;
        font-size: 14px;
      }
      button:hover {
        background: #f2f7f8;
      }
      button.primary {
        background: var(--accent);
        color: #fff;
      }
      button.primary:hover {
        background: var(--accent-dark);
      }
      .msg {
        font-size: 13px;
        color: #3b474b;
        min-height: 18px;
      }
      form {
        display: flex;
        flex-direction: column;
        gap: 12px;
        margin-top: 12px;
      }
      label {
        display: flex;
        flex-direction: column;
        gap: 4px;
        font-size: 13px;
        color: var(--ink-soft);
      }
      label input,
      label select {
        width: 100%;
      }
      label.inline,
      label.chk {
        flex-direction: row;
        align-items: center;
        gap: 8px;
        color: var(--ink);
      }
      .grid {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 12px;
      }
      .grid-2 {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
      }
      fieldset {
        border: 1px solid var(--border);
        border-radius: 3px;
        padding: 12px;
        margin: 0;
      }
      legend {
        font-size: 12px;
        color: var(--ink-soft);
      }
      .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 6px 14px;
      }
      .tags .chk {
        font-size: 12.5px;
      }
      pre {
        background: #0f1416;
        color: #e4eaea;
        padding: 14px;
        border-radius: 4px;
        overflow: auto;
        font-size: 12px;
      }
      @media (max-width: 640px) {
        .grid,
        .grid-2 {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </body>
</html>
