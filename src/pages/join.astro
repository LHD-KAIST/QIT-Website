---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { publicAssetExists } from '../lib/assets';
import { getMembers } from '../lib/collections';

// Contact email comes from the PI's record in members.json.
const members = await getMembers();
const pi = members.find((m) => m.role === 'pi');
const primary = pi?.emails.find((e) => e.primary) ?? pi?.emails[0];
const email = primary ? `${primary.user}@${primary.domain}` : null;

const hasImage = publicAssetExists('/images/join.webp');
---

<Base
  title="Join"
  current="join"
  description="Join the KAIST Quantum Information Theory group — email Prof. Changhun Oh."
>
  <PageHeader title="Join" />

  <div class="wrap join">
    {
      hasImage && (
        <img class="join__img" src="/images/join.webp" alt="Join our group" width="1600" height="893" />
      )
    }

    <p class="join__msg">
      If you are interested in joining our group, please feel free to email<br />
      Prof.{' '}{pi?.name}{email && (
        <>
          {' '}(<a href={`mailto:${email}`}>{email}</a>)
        </>
      )} !
    </p>
  </div>
</Base>

<style>
  .join {
    padding-top: 24px;
    padding-bottom: 56px;
  }
  .join__img {
    width: 100%;
    height: auto;
    display: block;
    border: 1px solid var(--soft);
    border-radius: var(--radius-card);
    margin-bottom: 44px;
  }
  .join__msg {
    margin: 0 auto;
    font-family: var(--font-display);
    font-size: clamp(19px, 3vw, 29px);
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: -0.01em;
    color: var(--ink);
    text-align: center;
  }
  .join__msg a {
    color: var(--cyan);
    border-bottom: 1px solid color-mix(in srgb, var(--cyan) 45%, transparent);
    white-space: nowrap;
  }
  .join__msg a:hover {
    border-color: var(--cyan);
  }
</style>
