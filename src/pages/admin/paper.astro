---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getMembers, getTags, getPublications } from '../../lib/collections';

const REPO = 'LHD-KAIST/QIT-Website';
const BRANCH = 'main';

// Embedded at build time for client-side author-matching + tag picker.
const members = (await getMembers()).map((m) => ({
  id: m.id,
  name: m.name,
  authorKey: m.authorKey || '',
  role: m.role,
}));
const tags = (await getTags()).map((t) => ({ id: t.id, label: t.label }));

// Existing papers, newest first, grouped by year for the edit list.
const pubs = await getPublications();
const years = [...new Set(pubs.map((p) => p.year))].sort((a, b) => b - a);
const byYear = years.map((y) => ({ year: y, papers: pubs.filter((p) => p.year === y) }));
---

<AdminLayout title="Papers" active="paper">
  <script type="application/json" id="members-data" set:html={JSON.stringify(members)}></script>
  <script type="application/json" id="tags-data" set:html={JSON.stringify(tags)}></script>
  <script type="application/json" id="papers-full" set:html={JSON.stringify(pubs)}></script>

  <h1>Add a paper</h1>
  <ol class="steps">
    <li>Paste a <b>DOI</b> or <b>arXiv</b> link/number below → press <b>Fetch</b>.</li>
    <li>Check the auto-filled details, and pick <b>1–2 tags</b>.</li>
    <li>
      Press <b>Create on GitHub →</b>. GitHub opens with the file ready — just press
      <b>Commit changes</b>. The site updates in ~1–2 min.
    </li>
  </ol>
  <p class="note">You must be signed in to GitHub with edit access.</p>

  <div class="row">
    <input id="src" type="text" placeholder="e.g. arXiv:2607.19017  or  10.1126/science.adv2560" />
    <button id="fetchBtn" type="button">Fetch</button>
  </div>
  <p id="msg" class="msg"></p>

  <form id="form" hidden>
    <label>Title <input name="title" type="text" /></label>

    <fieldset>
      <legend>
        Authors <small>(in order). For each: <b>None</b> = external · <b>Lab member</b> = shown
        bold · <b>PI</b> = bold + ∗ (corresponding)</small>
      </legend>
      <div id="authors"></div>
    </fieldset>

    <div class="grid">
      <label>Year <input name="year" type="number" /></label>
      <label>Order in year <input name="order" type="number" value="0" /></label>
      <label>Type
        <select name="type">
          <option value="journal">journal</option>
          <option value="preprint">preprint</option>
        </select>
      </label>
    </div>

    <label>Venue (badge) <input name="venue" type="text" /></label>
    <label>Citation <input name="citation" type="text" /></label>
    <label>URL <input name="url" type="text" /></label>
    <label>arXiv id <small>(preprints)</small> <input name="arxiv" type="text" /></label>
    <label>Note <small>(optional, e.g. Editors' Suggestion)</small> <input name="note" type="text" /></label>

    <fieldset>
      <legend>Tags <small>(pick 1–2 that best fit)</small></legend>
      <div id="tags" class="tags"></div>
    </fieldset>

    <label class="inline"><input name="highlight" type="checkbox" /> Feature on the home page (highlight)</label>

    <label>File id <small>(filename; auto-suggested)</small> <input name="id" type="text" /></label>

    <div class="row">
      <button id="createBtn" type="button" class="primary">Save (commit)</button>
      <button id="newPaperBtn" type="button" hidden>+ New paper</button>
      <button id="copyBtn" type="button">Copy JSON</button>
    </div>
    <pre id="preview"></pre>
  </form>

  <h2>Edit existing papers</h2>
  <p class="note">
    <b>Edit</b> loads the paper into the form above; <b>Save</b> commits the change.
    {pubs.length} papers.
  </p>
  {
    byYear.map((grp) => (
      <section class="grp">
        <h3>{grp.year}</h3>
        <ul class="plist">
          {grp.papers.map((p) => (
            <li class="prow">
              <div class="pinfo">
                <span class="ptitle">{p.title}</span>
                <span class="pmeta">
                  {p.venue}
                  {p.highlight ? ' · ★ highlighted' : ''} · <code>{p.id}</code>
                </span>
              </div>
              <button type="button" class="mlink edit editPaperBtn" data-id={p.id}>
                Edit
              </button>
            </li>
          ))}
        </ul>
      </section>
    ))
  }

  <script define:vars={{ REPO, BRANCH }}>
    const members = JSON.parse(document.getElementById('members-data').textContent);
    const tags = JSON.parse(document.getElementById('tags-data').textContent);
    const pi = members.find((m) => m.role === 'pi');
    const $ = (s, r = document) => r.querySelector(s);
    const msg = $('#msg');
    const pById = Object.fromEntries(
      JSON.parse(document.getElementById('papers-full').textContent).map((p) => [p.id, p]),
    );
    let mode = 'create'; // 'create' | 'update'

    // "Zheng-Hao Liu" -> "Z.-H. Liu"
    function initials(given) {
      return given
        .trim()
        .split(/\s+/)
        .map((w) => w.split('-').map((p) => (p ? p[0].toUpperCase() + '.' : '')).join('-'))
        .join(' ');
    }
    function toShort(full) {
      const parts = full.trim().split(/\s+/);
      if (parts.length < 2) return full.trim();
      return initials(parts.slice(0, -1).join(' ')) + ' ' + parts[parts.length - 1];
    }
    function matchMember(full) {
      const norm = full.trim().toLowerCase();
      return members.find((m) => m.name.trim().toLowerCase() === norm) || null;
    }
    function slugify(s) {
      return s.toLowerCase().normalize('NFKD').replace(/[^a-z0-9]+/g, '').slice(0, 14);
    }

    // Render tag checkboxes
    $('#tags').innerHTML = tags
      .map((t) => `<label class="chk"><input type="checkbox" value="${t.id}" /> ${t.label}</label>`)
      .join('');

    let authorState = [];
    function renderAuthors() {
      const radio = (i, val, label, cur) =>
        `<label class="chk"><input type="radio" data-i="${i}" class="a-role" name="role-${i}" value="${val}" ${
          cur === val ? 'checked' : ''
        }/> ${label}</label>`;
      $('#authors').innerHTML = authorState
        .map(
          (a, i) => `<div class="author">
            <input data-i="${i}" class="a-name" type="text" value="${a.name.replace(/"/g, '&quot;')}" />
            <div class="a-roles">
              ${radio(i, 'none', 'None', a.role)}
              ${radio(i, 'member', 'Lab member', a.role)}
              ${radio(i, 'pi', 'PI', a.role)}
            </div>
          </div>`,
        )
        .join('');
    }

    async function doFetch() {
      const id = $('#src').value.trim();
      if (!id) return;
      msg.textContent = 'Fetching…';
      try {
        const res = await fetch('/fetch-paper?id=' + encodeURIComponent(id));
        const d = await res.json();
        if (d.error) {
          msg.textContent = '⚠ ' + d.error;
          return;
        }
        // author matching -> None / Lab member / PI
        authorState = (d.authors || []).map((full) => {
          const m = matchMember(full);
          if (!m) return { name: toShort(full), memberId: '', role: 'none' };
          return {
            name: m.authorKey || toShort(full),
            memberId: m.id,
            role: m.role === 'pi' ? 'pi' : 'member',
          };
        });
        $('#form').hidden = false;
        mode = 'create';
        $('[name=id]').readOnly = false;
        $('#newPaperBtn').hidden = true;
        $('#createBtn').textContent = 'Save (commit)';
        $('[name=title]').value = d.title || '';
        $('[name=year]').value = d.year || '';
        $('[name=type]').value = d.type || 'journal';
        $('[name=venue]').value = d.venue || '';
        $('[name=citation]').value = d.citation || '';
        $('[name=url]').value = d.url || '';
        $('[name=arxiv]').value = d.arxiv || '';
        const first = (authorState[0]?.name || 'paper').split(' ').pop();
        $('[name=id]').value = slugify(first) + (d.year || '') + slugify((d.title || '').split(' ')[0] || '');
        renderAuthors();
        buildPreview();
        msg.textContent = '✓ Fetched. Review below.';
      } catch (e) {
        msg.textContent = '⚠ ' + e;
      }
    }

    function collect() {
      const f = $('#form');
      const authors = authorState.map((a) => {
        const o = { name: a.name };
        if (a.role === 'member' || a.role === 'pi') {
          o.group = true;
          if (a.memberId) o.memberId = a.memberId;
        }
        if (a.role === 'pi') o.corresponding = true;
        return o;
      });
      const chosenTags = [...$('#tags').querySelectorAll('input:checked')].map((c) => c.value);
      const type = f.type.value;
      const obj = {
        id: f.id.value.trim(),
        title: f.title.value.trim(),
        authors,
        year: Number(f.year.value) || null,
        order: Number(f.order.value) || 0,
        type,
        venue: f.venue.value.trim(),
        citation: f.citation.value.trim(),
        url: f.url.value.trim(),
        tags: chosenTags,
        highlight: f.highlight.checked,
        note: f.note.value.trim() || null,
      };
      if (type === 'preprint' && f.arxiv.value.trim()) obj.arxiv = f.arxiv.value.trim();
      return obj;
    }
    function buildPreview() {
      $('#preview').textContent = JSON.stringify(collect(), null, 2);
    }

    // events
    $('#fetchBtn').addEventListener('click', doFetch);
    $('#src').addEventListener('keydown', (e) => e.key === 'Enter' && (e.preventDefault(), doFetch()));
    $('#authors').addEventListener('input', (e) => {
      const i = e.target.dataset.i;
      if (i != null && e.target.classList.contains('a-name')) {
        authorState[i].name = e.target.value;
        buildPreview();
      }
    });
    $('#authors').addEventListener('change', (e) => {
      const i = e.target.dataset.i;
      if (i == null || !e.target.classList.contains('a-role')) return;
      const role = e.target.value;
      authorState[i].role = role;
      if (role === 'pi') authorState[i].memberId = pi ? pi.id : 'oh-changhun';
      else if (role === 'none') authorState[i].memberId = '';
      buildPreview();
    });
    $('#form').addEventListener('input', buildPreview);
    $('#tags').addEventListener('change', buildPreview);

    function loadPaper(id) {
      const p = pById[id];
      if (!p) return;
      mode = 'update';
      $('#form').hidden = false;
      $('[name=title]').value = p.title || '';
      $('[name=year]').value = p.year ?? '';
      $('[name=order]').value = p.order ?? 0;
      $('[name=type]').value = p.type || 'journal';
      $('[name=venue]').value = p.venue || '';
      $('[name=citation]').value = p.citation || '';
      $('[name=url]').value = p.url || '';
      $('[name=arxiv]').value = p.arxiv || '';
      $('[name=note]').value = p.note || '';
      $('[name=highlight]').checked = !!p.highlight;
      $('[name=id]').value = p.id;
      $('[name=id]').readOnly = true;
      authorState = (p.authors || []).map((a) => ({
        name: a.name,
        memberId: a.memberId || '',
        role: a.corresponding ? 'pi' : a.group ? 'member' : 'none',
      }));
      renderAuthors();
      const chosen = new Set(p.tags || []);
      $('#tags')
        .querySelectorAll('input[type=checkbox]')
        .forEach((c) => (c.checked = chosen.has(c.value)));
      $('#newPaperBtn').hidden = false;
      $('#createBtn').textContent = 'Save changes (commit)';
      buildPreview();
      msg.textContent = 'Editing ' + p.id + '.';
      document.getElementById('form').scrollIntoView({ behavior: 'smooth' });
    }
    function newPaper() {
      mode = 'create';
      $('#form').reset();
      authorState = [];
      renderAuthors();
      $('#tags')
        .querySelectorAll('input[type=checkbox]')
        .forEach((c) => (c.checked = false));
      $('[name=id]').readOnly = false;
      $('#form').hidden = true;
      $('#createBtn').textContent = 'Save (commit)';
      $('#newPaperBtn').hidden = true;
      msg.textContent = 'Paste a DOI/arXiv above to start a new paper.';
    }

    document.querySelectorAll('.editPaperBtn').forEach((b) =>
      b.addEventListener('click', () => loadPaper(b.dataset.id)),
    );
    $('#newPaperBtn').addEventListener('click', newPaper);

    $('#createBtn').addEventListener('click', async () => {
      const obj = collect();
      if (!obj.id) return (msg.textContent = '⚠ Please set a File id.');
      if (!obj.title) return (msg.textContent = '⚠ Please set a title.');
      const btn = $('#createBtn');
      btn.disabled = true;
      msg.textContent = 'Saving…';
      try {
        const content = JSON.stringify(obj, null, 2) + '\n';
        const res = await window.qitAdmin.saveFile({
          path: 'src/data/publications/' + obj.id + '.json',
          content,
          message: (mode === 'update' ? 'Update paper ' : 'Add paper ') + obj.id,
        });
        msg.textContent =
          '✓ ' +
          (res.created ? 'Created' : 'Updated') +
          '. The site rebuilds in ~1–2 min — reload then to refresh the list.';
        if (mode === 'create') {
          mode = 'update';
          $('[name=id]').readOnly = true;
          $('#newPaperBtn').hidden = false;
          $('#createBtn').textContent = 'Save changes (commit)';
        }
      } catch (e) {
        msg.textContent = '⚠ ' + e.message;
      } finally {
        btn.disabled = false;
      }
    });
    $('#copyBtn').addEventListener('click', async () => {
      await navigator.clipboard.writeText(JSON.stringify(collect(), null, 2) + '\n');
      msg.textContent = '✓ JSON copied.';
    });
  </script>

  <style>
    #src {
      flex: 1;
      min-width: 260px;
    }
    .author {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 14px;
      margin-bottom: 8px;
      align-items: center;
    }
    .a-roles {
      display: flex;
      gap: 14px;
      white-space: nowrap;
    }
    .a-roles .chk {
      gap: 5px;
    }
    h3 {
      font-size: 14px;
      color: var(--ink-soft);
      margin: 16px 0 6px;
    }
    .plist {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .prow {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 10px 14px;
    }
    .ptitle {
      font-weight: 600;
      font-size: 14px;
      line-height: 1.35;
    }
    .pmeta {
      display: block;
      font-size: 12px;
      color: var(--ink-soft);
      margin-top: 2px;
    }
    .pmeta code {
      font-size: 11.5px;
      background: #e4ebec;
      padding: 1px 5px;
      border-radius: 3px;
    }
    .mlink.edit {
      font-size: 13px;
      text-decoration: none;
      padding: 5px 10px;
      border-radius: 4px;
      white-space: nowrap;
      flex-shrink: 0;
      background: var(--accent);
      color: #fff;
      border: 1px solid var(--accent);
    }
    .mlink.edit:hover {
      background: var(--accent-dark);
    }
    @media (max-width: 560px) {
      .prow {
        flex-direction: column;
        align-items: flex-start;
      }
    }
  </style>
</AdminLayout>
