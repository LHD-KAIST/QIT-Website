---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getMembers } from '../../lib/collections';
import { buildMemberHrefs } from '../../lib/people';

const members = await getMembers();
const hrefs = buildMemberHrefs(members);

// Section order (rank) + short uppercase labels. Any member whose role isn't
// listed still shows up under "OTHER" so nothing is ever hidden.
const ROLE_ORDER: [string, string][] = [
  ['pi', 'PI'],
  ['postdoc', 'POSTDOC'],
  ['grad', 'GRAD'],
  ['undergrad', 'UNDERGRAD'],
  ['ra', 'RA'],
  ['alumni', 'ALUMNI'],
];
const known = new Set(ROLE_ORDER.map(([r]) => r));

const groups = ROLE_ORDER.map(([role, label]) => ({
  label,
  members: members
    .filter((m) => m.role === role)
    .sort((a, b) => a.name.localeCompare(b.name)),
})).filter((g) => g.members.length > 0);

const orphans = members
  .filter((m) => !known.has(m.role))
  .sort((a, b) => a.name.localeCompare(b.name));
if (orphans.length) groups.push({ label: 'OTHER', members: orphans });
---

<AdminLayout title="Members" active="member">
  <script type="application/json" id="members-full" set:html={JSON.stringify(members)}></script>

  <h1>Members</h1>
  <p class="note">
    Grouped by section (PI → POSTDOC → GRAD → UNDERGRAD → ALUMNI), alphabetical by
    name. <b>Edit</b> loads a person into the form below; <b>Save</b> commits straight
    to the repo (you sign in with GitHub once). The site updates ~1–2 min later.
  </p>

  {
    groups.map((g) => (
      <section class="grp">
        <h2>
          {g.label} <span class="count">{g.members.length}</span>
        </h2>
        <ul class="mlist">
          {g.members.map((m) => (
            <li class="mrow" data-id={m.id}>
              <div class="minfo">
                <span class="mname">{m.name}</span>
                <span class="mmeta">
                  {m.roleLabel}
                  {m.title ? ` · ${m.title}` : ''} · <code>{m.id}</code>
                </span>
              </div>
              <div class="macts">
                {hrefs.get(m.id) && (
                  <a class="mlink" href={hrefs.get(m.id)} target="_blank" rel="noopener">
                    View
                  </a>
                )}
                <button type="button" class="mlink edit editBtn" data-id={m.id}>
                  Edit
                </button>
              </div>
            </li>
          ))}
        </ul>
      </section>
    ))
  }

  <h2 id="editor">Add / edit a member</h2>
  <p class="note" id="editorMode">Creating a new member. Photos: upload separately into <code>public/images/people/</code>.</p>

  <form id="form">
    <div class="grid-2">
      <label>Full name <input name="name" type="text" placeholder="Hodong Lee" /></label>
      <label>File id <small>(filename; locked when editing)</small>
        <input name="id" type="text" placeholder="lee-hodong" /></label>
    </div>

    <div class="grid">
      <label>Section
        <select name="role">
          <option value="pi">PI (Team Leader)</option>
          <option value="postdoc">Postdoc</option>
          <option value="grad" selected>Graduate</option>
          <option value="undergrad">Undergraduate</option>
          <option value="alumni">Alumni</option>
          <option value="ra">RA</option>
        </select>
      </label>
      <label>Role label <small>(shown under name)</small>
        <input name="roleLabel" type="text" placeholder="Graduate Student" /></label>
      <label>Order in section <small>(0 = first)</small>
        <input name="order" type="number" value="0" /></label>
    </div>

    <div class="grid">
      <label>Title <small>(optional)</small><input name="title" type="text" placeholder="Assistant Professor" /></label>
      <label>Affiliation <input name="affiliation" type="text" value="KAIST Physics" /></label>
      <label>Author key <small>(e.g. C. Oh)</small><input name="authorKey" type="text" /></label>
    </div>

    <fieldset>
      <legend>Emails</legend>
      <div id="emails"></div>
      <button type="button" id="addEmail" class="mini">+ email</button>
    </fieldset>

    <fieldset>
      <legend>Academic career</legend>
      <div id="edu"></div>
      <button type="button" id="addEdu" class="mini">+ entry</button>
    </fieldset>

    <label>Photo path <small>(optional; upload the image first)</small>
      <input name="photo" type="text" placeholder="/images/people/lee-hodong.jpg" /></label>

    <label>Research interests <small>(comma-separated)</small>
      <input name="interests" type="text" placeholder="Quantum information theory, Quantum algorithms" /></label>

    <fieldset>
      <legend>Links <small>(optional)</small></legend>
      <div class="grid-2">
        <label>Google Scholar URL<input name="scholar" type="text" /></label>
        <label>Personal homepage URL<input name="website" type="text" /></label>
        <label>arXiv URL<input name="arxiv" type="text" /></label>
        <label>ORCID URL<input name="orcid" type="text" /></label>
      </div>
    </fieldset>

    <label>Next position <small>(Alumni only, e.g. PhD student, U. of Waterloo)</small>
      <input name="nextPosition" type="text" /></label>
    <label>Bio <small>(optional)</small><input name="bio" type="text" /></label>

    <div class="row">
      <button id="saveBtn" type="button" class="primary">Save (commit)</button>
      <button id="newBtn" type="button" hidden>+ New member</button>
      <button id="copyBtn" type="button">Copy JSON</button>
    </div>
    <p id="msg" class="msg"></p>
    <pre id="preview"></pre>
  </form>

  <script>
    const ALL = JSON.parse(document.getElementById('members-full').textContent);
    const byId = Object.fromEntries(ALL.map((m) => [m.id, m]));
    const $ = (s, r = document) => r.querySelector(s);
    const f = $('#form');
    const msg = $('#msg');

    const ROLE_LABELS = {
      pi: 'Team Leader',
      postdoc: 'Postdoctoral Researcher',
      grad: 'Graduate Student',
      undergrad: 'Undergraduate Student',
      alumni: 'Alumni',
      ra: 'Research Assistant',
    };

    let mode = 'create'; // 'create' | 'update'
    let currentDoc = null; // full loaded doc (preserves fields not in the form)
    let emailRows = [{ user: '', domain: 'kaist.ac.kr', primary: true }];
    let eduRows = [];

    const esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/"/g, '&quot;');

    function renderEmails() {
      $('#emails').innerHTML = emailRows
        .map(
          (e, i) => `<div class="lrow">
            <input class="e-user" data-i="${i}" placeholder="user" value="${esc(e.user)}" />
            <span class="at">@</span>
            <input class="e-domain" data-i="${i}" placeholder="domain" value="${esc(e.domain)}" />
            <label class="chk"><input type="checkbox" class="e-primary" data-i="${i}" ${e.primary ? 'checked' : ''} /> primary</label>
            <button type="button" class="rm" data-kind="email" data-i="${i}">×</button>
          </div>`,
        )
        .join('');
    }
    function renderEdu() {
      $('#edu').innerHTML = eduRows
        .map(
          (e, i) => `<div class="lrow edu">
            <input class="d-position" data-i="${i}" placeholder="Position / Degree" value="${esc(e.position)}" />
            <input class="d-period" data-i="${i}" placeholder="Period (e.g. 2024 – present)" value="${esc(e.period)}" />
            <input class="d-org" data-i="${i}" placeholder="Organization" value="${esc(e.org)}" />
            <button type="button" class="rm" data-kind="edu" data-i="${i}">×</button>
          </div>`,
        )
        .join('');
    }

    function fill(obj) {
      const g = (k, d = '') => (obj[k] == null ? d : obj[k]);
      f.name.value = g('name');
      f.id.value = g('id');
      f.role.value = g('role', 'grad');
      f.roleLabel.value = g('roleLabel');
      f.order.value = g('order', 0);
      f.title.value = g('title');
      f.affiliation.value = g('affiliation', 'KAIST Physics');
      f.authorKey.value = g('authorKey');
      f.photo.value = g('photo');
      f.interests.value = (obj.interests || []).join(', ');
      const links = obj.links || {};
      f.scholar.value = links.scholar || '';
      f.website.value = links.website || '';
      f.arxiv.value = links.arxiv || '';
      f.orcid.value = links.orcid || '';
      f.nextPosition.value = g('nextPosition');
      f.bio.value = g('bio');
      emailRows = (obj.emails && obj.emails.length ? obj.emails : [{ user: '', domain: 'kaist.ac.kr', primary: true }]).map(
        (e) => ({ user: e.user || '', domain: e.domain || 'kaist.ac.kr', primary: !!e.primary }),
      );
      eduRows = (obj.education || []).map((e) => ({
        position: e.position || '',
        period: e.period || '',
        org: e.org || '',
      }));
      renderEmails();
      renderEdu();
    }

    function loadMember(id) {
      const m = byId[id];
      if (!m) return;
      currentDoc = m;
      mode = 'update';
      fill(m);
      f.id.readOnly = true;
      f.id.dataset.touched = '1';
      f.roleLabel.dataset.touched = '1';
      f.photo.dataset.touched = '1';
      $('#editorMode').innerHTML = `Editing <b>${esc(m.name)}</b> (<code>${esc(m.id)}</code>). Save commits an update to this file.`;
      $('#saveBtn').textContent = 'Save changes (commit)';
      $('#newBtn').hidden = false;
      buildPreview();
      document.getElementById('editor').scrollIntoView({ behavior: 'smooth' });
    }

    function newMember() {
      currentDoc = null;
      mode = 'create';
      f.reset();
      f.id.readOnly = false;
      delete f.id.dataset.touched;
      delete f.roleLabel.dataset.touched;
      delete f.photo.dataset.touched;
      emailRows = [{ user: '', domain: 'kaist.ac.kr', primary: true }];
      eduRows = [];
      f.roleLabel.value = ROLE_LABELS[f.role.value] || '';
      renderEmails();
      renderEdu();
      $('#editorMode').innerHTML =
        'Creating a new member. Photos: upload separately into <code>public/images/people/</code>.';
      $('#saveBtn').textContent = 'Save (commit)';
      $('#newBtn').hidden = true;
      msg.textContent = '';
      buildPreview();
    }

    function suggestId(name) {
      const parts = name.trim().toLowerCase().split(/\s+/).filter(Boolean);
      if (parts.length < 2) return (parts[0] || '').replace(/[^a-z0-9-]/g, '');
      return (parts[parts.length - 1] + '-' + parts.slice(0, -1).join('-')).replace(/[^a-z0-9-]/g, '');
    }

    function collect() {
      const v = (n) => (f[n]?.value ?? '').trim();
      const base = mode === 'update' && currentDoc ? { ...currentDoc } : {};
      const emails = emailRows
        .filter((e) => e.user.trim())
        .map((e) => ({ user: e.user.trim(), domain: (e.domain || 'kaist.ac.kr').trim(), primary: !!e.primary }));
      const education = eduRows
        .filter((e) => e.position.trim())
        .map((e) => ({ position: e.position.trim(), period: e.period.trim(), org: e.org.trim() }));
      const interests = v('interests').split(',').map((s) => s.trim()).filter(Boolean);
      return {
        ...base,
        id: v('id'),
        name: v('name'),
        role: v('role'),
        roleLabel: v('roleLabel'),
        affiliation: v('affiliation'),
        order: Number(v('order')) || 0,
        title: v('title'),
        emails,
        photo: v('photo'),
        bio: v('bio') || null,
        education,
        interests,
        links: {
          scholar: v('scholar') || null,
          website: v('website') || null,
          arxiv: v('arxiv') || null,
          orcid: v('orcid') || null,
        },
        authorKey: v('authorKey') || null,
        nextPosition: v('nextPosition') || null,
      };
    }
    function buildPreview() {
      $('#preview').textContent = JSON.stringify(collect(), null, 2);
    }

    // --- list edit buttons ---
    document.querySelectorAll('.editBtn').forEach((b) =>
      b.addEventListener('click', () => loadMember(b.dataset.id)),
    );

    // --- repeatable rows ---
    $('#addEmail').addEventListener('click', () => {
      emailRows.push({ user: '', domain: 'kaist.ac.kr', primary: emailRows.length === 0 });
      renderEmails();
      buildPreview();
    });
    $('#addEdu').addEventListener('click', () => {
      eduRows.push({ position: '', period: '', org: '' });
      renderEdu();
      buildPreview();
    });
    $('#emails').addEventListener('input', (e) => {
      const i = e.target.dataset.i;
      if (i == null) return;
      if (e.target.classList.contains('e-user')) emailRows[i].user = e.target.value;
      else if (e.target.classList.contains('e-domain')) emailRows[i].domain = e.target.value;
      else if (e.target.classList.contains('e-primary')) emailRows[i].primary = e.target.checked;
      buildPreview();
    });
    $('#edu').addEventListener('input', (e) => {
      const i = e.target.dataset.i;
      if (i == null) return;
      if (e.target.classList.contains('d-position')) eduRows[i].position = e.target.value;
      else if (e.target.classList.contains('d-period')) eduRows[i].period = e.target.value;
      else if (e.target.classList.contains('d-org')) eduRows[i].org = e.target.value;
      buildPreview();
    });
    function onRemove(e) {
      const btn = e.target.closest('.rm');
      if (!btn) return;
      const i = Number(btn.dataset.i);
      if (btn.dataset.kind === 'email') {
        emailRows.splice(i, 1);
        renderEmails();
      } else {
        eduRows.splice(i, 1);
        renderEdu();
      }
      buildPreview();
    }
    $('#emails').addEventListener('click', onRemove);
    $('#edu').addEventListener('click', onRemove);

    // --- auto-suggest (create mode only) ---
    f.name.addEventListener('input', () => {
      if (mode === 'create' && !f.id.dataset.touched) {
        f.id.value = suggestId(f.name.value);
        syncPhoto();
      }
      buildPreview();
    });
    f.id.addEventListener('input', () => {
      f.id.dataset.touched = '1';
      if (mode === 'create') syncPhoto();
      buildPreview();
    });
    f.role.addEventListener('change', () => {
      if (!f.roleLabel.dataset.touched) f.roleLabel.value = ROLE_LABELS[f.role.value] || '';
      buildPreview();
    });
    f.roleLabel.addEventListener('input', () => (f.roleLabel.dataset.touched = '1'));
    function syncPhoto() {
      if (!f.photo.dataset.touched) f.photo.value = f.id.value ? `/images/people/${f.id.value}.jpg` : '';
    }
    f.photo.addEventListener('input', () => (f.photo.dataset.touched = '1'));
    f.addEventListener('input', buildPreview);

    // --- actions ---
    $('#newBtn').addEventListener('click', newMember);
    $('#copyBtn').addEventListener('click', async () => {
      await navigator.clipboard.writeText(JSON.stringify(collect(), null, 2) + '\n');
      msg.textContent = '✓ JSON copied.';
    });
    $('#saveBtn').addEventListener('click', async () => {
      const obj = collect();
      if (!obj.id) return (msg.textContent = '⚠ Please set a File id.');
      if (!obj.name) return (msg.textContent = '⚠ Please set a name.');
      const btn = $('#saveBtn');
      btn.disabled = true;
      msg.textContent = 'Saving…';
      try {
        const content = JSON.stringify(obj, null, 2) + '\n';
        const res = await window.qitAdmin.saveFile({
          path: 'src/data/members/' + obj.id + '.json',
          content,
          message: (mode === 'update' ? 'Update member ' : 'Add member ') + obj.name,
        });
        msg.textContent =
          '✓ ' + (res.created ? 'Created' : 'Updated') + '. The site rebuilds in ~1–2 min — reload then to refresh the list.';
        if (mode === 'create') {
          mode = 'update';
          currentDoc = obj;
          f.id.readOnly = true;
          $('#newBtn').hidden = false;
        }
      } catch (e) {
        msg.textContent = '⚠ ' + e.message;
      } finally {
        btn.disabled = false;
      }
    });

    // init
    newMember();
  </script>

  <style>
    .grp {
      margin-bottom: 4px;
    }
    h2 .count {
      font-size: 12px;
      font-weight: 600;
      color: var(--ink-soft);
      background: #dfe7e8;
      border-radius: 10px;
      padding: 1px 8px;
      vertical-align: middle;
      margin-left: 4px;
    }
    .mlist {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .mrow {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 10px 14px;
    }
    .mname {
      font-weight: 600;
      font-size: 15px;
    }
    .mmeta {
      display: block;
      font-size: 12px;
      color: var(--ink-soft);
      margin-top: 2px;
    }
    .mmeta code,
    .note code,
    #editorMode code {
      font-size: 11.5px;
      background: #e4ebec;
      padding: 1px 5px;
      border-radius: 3px;
    }
    .macts {
      display: flex;
      gap: 8px;
      white-space: nowrap;
      flex-shrink: 0;
    }
    .mlink {
      font-size: 13px;
      text-decoration: none;
      color: var(--accent);
      padding: 5px 10px;
      border: 1px solid var(--border);
      border-radius: 4px;
      background: var(--surface);
      cursor: pointer;
    }
    .mlink:hover {
      border-color: var(--accent);
    }
    .mlink.edit {
      background: var(--accent);
      color: #fff;
      border-color: var(--accent);
    }
    .mlink.edit:hover {
      background: var(--accent-dark);
    }
    .lrow {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 6px;
    }
    .lrow.edu {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr auto;
    }
    .lrow input[type='text'],
    .lrow input:not([type]) {
      flex: 1;
    }
    .lrow .at {
      color: var(--ink-soft);
    }
    .lrow .rm {
      padding: 4px 9px;
      border-color: #d7b2b2;
      color: #a23b3b;
    }
    button.mini {
      padding: 5px 10px;
      font-size: 12.5px;
    }
    @media (max-width: 560px) {
      .mrow {
        flex-direction: column;
        align-items: flex-start;
      }
      .lrow.edu {
        grid-template-columns: 1fr;
      }
    }
  </style>
</AdminLayout>
