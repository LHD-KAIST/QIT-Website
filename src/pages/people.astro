---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { getMembers } from '../lib/collections';
import { ROLE_GROUPS, membersOf } from '../lib/people';

const members = await getMembers();
const groups = ROLE_GROUPS.map((g) => ({
  ...g,
  count: g.role ? membersOf(members, g.role).length : null,
}));
---

<Base
  title="People"
  current="people"
  description="The people of the Quantum Information Theory group at KAIST — most of them students."
>
  <PageHeader title="People" />

  <nav class="wrap pindex" aria-label="People sections">
    {
      groups.map((g) => (
        <a class="pindex__row" href={`/people/${g.slug}`}>
          <span class="pindex__label">{g.label}</span>
          {g.count !== null && <span class="pindex__count">{g.count}</span>}
          <span class="pindex__chev" aria-hidden="true" />
        </a>
      ))
    }
  </nav>
</Base>

<style>
  .pindex {
    padding-top: 32px;
    padding-bottom: 24px;
  }
  .pindex__row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 22px 2px;
    border-top: 1px solid var(--rule);
    color: var(--ink);
    min-height: 44px;
  }
  .pindex__row:last-child {
    border-bottom: 1px solid var(--rule);
  }
  .pindex__row:hover {
    color: var(--cyan);
  }
  .pindex__label {
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 500;
  }
  .pindex__count {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
  }
  .pindex__chev {
    margin-left: auto;
    width: 9px;
    height: 9px;
    border-right: 2px solid var(--muted);
    border-bottom: 2px solid var(--muted);
    transform: rotate(-45deg);
    transition: transform 0.16s ease, border-color 0.16s ease;
  }
  .pindex__row:hover .pindex__chev {
    border-color: var(--cyan);
    transform: rotate(-45deg) translate(2px, 2px);
  }
</style>
