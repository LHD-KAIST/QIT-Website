---
import Base from '../layouts/Base.astro';
import SelectedPaperCard from '../components/SelectedPaperCard.astro';
import Placeholder from '../components/Placeholder.astro';
import { publicAssetExists } from '../lib/assets';
import { getPublications, sortPublications } from '../lib/collections';

const hasGroupPhoto = publicAssetExists('/images/group.jpg');

const pubs = await getPublications();

// Selected papers: drawn from `highlight`, newest first, four of them.
const selected = sortPublications(pubs.filter((p) => p.highlight)).slice(0, 4);
---

<Base>
  {/* HERO — group photo with a welcome overlay, over a soft gradient wash */}
  <section class="hero">
    <div class="hero__field" aria-hidden="true"></div>
    <div class="wrap hero__inner">
      <div class="hero__photo">
        {
          hasGroupPhoto ? (
            <img src="/images/group.jpg" alt="The KAIST Physics Quantum Information Theory group" width="2000" height="1500" />
          ) : (
            <Placeholder variant="figure" ratio="3 / 2" label="Group photo — add public/images/group.jpg" />
          )
        }
        <div class="hero__overlay">
          <h1 class="hero__welcome">Welcome to KAIST Physics<br />Quantum Information Theory Group!</h1>
        </div>
      </div>
    </div>
  </section>

  {/* Selected papers — each card takes on its journal's own accent */}
  <section class="wrap home-block">
    <div class="selected__head">
      <span class="eyebrow">Selected papers</span>
      <a class="quiet-link" href="/publications">All publications →</a>
    </div>
    <div class="selected__grid">
      {selected.map((p) => <SelectedPaperCard pub={p} />)}
    </div>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(40px, 7vh, 80px) clamp(48px, 8vw, 88px);
  }
  /* refined background wash — soft cyan auras from opposite corners plus a faint
     diagonal sheen (cool daylight on glass). No repeating pattern; present but
     quiet, so it reads as depth rather than decoration. */
  .hero__field {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    background:
      radial-gradient(
        1150px 820px at 90% -12%,
        color-mix(in srgb, var(--cyan) 15%, transparent) 0%,
        transparent 58%
      ),
      radial-gradient(
        1000px 780px at 4% 112%,
        color-mix(in srgb, var(--cyan) 12%, transparent) 0%,
        transparent 56%
      ),
      linear-gradient(
        122deg,
        transparent 34%,
        color-mix(in srgb, var(--cyan) 4%, transparent) 60%,
        transparent 82%
      );
  }
  .hero__inner {
    position: relative;
    z-index: 1;
  }
  .hero__photo {
    position: relative;
    z-index: 1;
    overflow: hidden;
    border: 1px solid var(--soft);
    border-radius: var(--radius-card);
  }
  .hero__photo img {
    width: 100%;
    height: auto;
    display: block;
  }
  .hero__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    padding: clamp(20px, 4vw, 44px);
    background: linear-gradient(
      to top,
      rgba(12, 17, 19, 0.78) 0%,
      rgba(12, 17, 19, 0.35) 26%,
      rgba(12, 17, 19, 0) 55%
    );
  }
  .hero__welcome {
    margin: 0;
    color: #fff;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(22px, 3.6vw, 40px);
    line-height: 1.18;
    letter-spacing: -0.01em;
    max-width: 34ch;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.4);
    text-wrap: pretty;
  }

  .home-block {
    padding-block: clamp(40px, 7vw, 72px);
  }

  .selected__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 20px;
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 15px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .quiet-link {
    font-family: var(--font-display);
    font-size: 15px;
    color: var(--cyan);
    border-bottom: 1px solid color-mix(in srgb, var(--cyan) 40%, transparent);
    padding-bottom: 1px;
    white-space: nowrap;
  }

  .selected__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    align-items: stretch;
  }

  @media (max-width: 720px) {
    .selected__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
