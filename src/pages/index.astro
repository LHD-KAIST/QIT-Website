---
import Base from '../layouts/Base.astro';
import PublicationItem from '../components/PublicationItem.astro';
import { getPublications, getMembers, getAreaTags, getTags, sortPublications } from '../lib/collections';

const pubs = await getPublications();
const areas = await getAreaTags();
const tags = await getTags();
const members = await getMembers();
const tagLabels = new Map(tags.map((t) => [t.id, t.label]));

// Selected papers: drawn from `highlight`, newest first, four of them.
const selected = sortPublications(pubs.filter((p) => p.highlight)).slice(0, 4);

const pi = members.find((m) => m.role === 'pi');
const primary = pi?.emails.find((e) => e.primary) ?? pi?.emails[0];
const piEmail = primary ? `${primary.user}@${primary.domain}` : null;
---

<Base>
  {/* ── HERO C — one sentence, split by the boundary line ─────────────── */}
  <section class="hero">
    <div class="wrap hero__inner">
      <h1 class="hero__sentence">
        <span class="hero__a">We study the boundary between what quantum computers can do</span>
        <span class="hero__line" aria-hidden="true"><span class="hero__dot"></span></span>
        <span class="hero__b">and what classical ones cannot.</span>
      </h1>
      <div class="hero__foot">
        <span class="hero__place">Department of Physics · KAIST</span>
        <span class="hero__down" aria-hidden="true">↓</span>
      </div>
    </div>
  </section>

  {/* ── ① Research areas ──────────────────────────────────────────────── */}
  <section class="wrap home-block">
    <div class="areas">
      {
        areas.map((a) => (
          <a class="areas__item" href="/research">
            <div class="areas__name">{a.label}</div>
            <div class="areas__tag">{a.tagline}</div>
          </a>
        ))
      }
    </div>
  </section>

  {/* ── ② Selected papers ─────────────────────────────────────────────── */}
  <section class="wrap home-block">
    <div class="selected__head">
      <span class="eyebrow">Selected papers</span>
      <a class="quiet-link" href="/publications">All publications →</a>
    </div>
    <div>
      {selected.map((p) => <PublicationItem pub={p} tagLabels={tagLabels} compact />)}
    </div>
  </section>

  {/* ── ③ Where · Contact · Join ──────────────────────────────────────── */}
  <section class="wrap home-block">
    <div class="triple">
      <div>
        <div class="eyebrow">Where</div>
        <p class="triple__body">
          Department of Physics, KAIST<br />291 Daehak-ro, Yuseong-gu<br />Daejeon 34141, Korea
        </p>
      </div>
      <div>
        <div class="eyebrow">Contact</div>
        {piEmail && <a class="triple__email" href={`mailto:${piEmail}`}>{piEmail}</a>}
      </div>
      <div>
        <div class="eyebrow">Join</div>
        <p class="triple__body">We are looking for students who want to prove things.</p>
        <a class="quiet-link" href="/join">How to join →</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    display: flex;
    align-items: center;
    min-height: min(760px, 82vh);
    padding-block: clamp(48px, 10vh, 120px);
  }
  .hero__sentence {
    margin: 0;
    font-weight: 300;
  }
  .hero__a,
  .hero__b {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(30px, 5.4vw, 52px);
    font-weight: 300;
    line-height: 1.2;
    letter-spacing: -0.02em;
    text-wrap: pretty;
  }
  .hero__a {
    color: var(--ink);
    max-width: 22ch;
  }
  .hero__line {
    display: block;
    position: relative;
    height: 1px;
    background: var(--ink);
    margin: clamp(28px, 5vh, 52px) 0;
  }
  .hero__dot {
    position: absolute;
    left: 38%;
    top: -3.5px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--core);
  }
  .hero__b {
    color: var(--muted);
    text-align: right;
    margin-left: auto;
    max-width: 22ch;
  }
  .hero__foot {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-top: clamp(40px, 8vh, 64px);
  }
  .hero__place {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .hero__down {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
  }

  .home-block {
    padding-block: clamp(40px, 7vw, 72px);
  }

  .areas {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
  }
  .areas__item {
    display: block;
    border-top: 1px solid var(--ink);
    padding-top: 20px;
    color: var(--ink);
  }
  .areas__item:hover {
    border-color: var(--core);
  }
  .areas__name {
    font-family: var(--font-serif);
    font-size: 24px;
    line-height: 1.2;
  }
  .areas__tag {
    margin-top: 10px;
    font-family: var(--font-display);
    font-size: 14.5px;
    font-weight: 300;
    line-height: 1.5;
    color: color-mix(in srgb, var(--ink) 78%, var(--ground));
    text-wrap: pretty;
  }

  .selected__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 8px;
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .quiet-link {
    font-family: var(--font-display);
    font-size: 13.5px;
    color: var(--cyan);
    border-bottom: 1px solid color-mix(in srgb, var(--cyan) 40%, transparent);
    padding-bottom: 1px;
    white-space: nowrap;
  }

  .triple {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
    border-top: 1px solid var(--rule);
    padding-top: 36px;
  }
  .triple__body {
    margin: 12px 0 0;
    font-size: 14.5px;
    line-height: 1.65;
    color: color-mix(in srgb, var(--ink) 78%, var(--ground));
    text-wrap: pretty;
  }
  .triple__email {
    font-family: var(--font-mono);
    font-size: 12.5px;
    overflow-wrap: anywhere;
    border-bottom: 1px solid color-mix(in srgb, var(--cyan) 40%, transparent);
  }
  .triple .quiet-link {
    display: inline-block;
    margin-top: 12px;
  }

  @media (max-width: 820px) {
    .areas,
    .triple {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }
</style>
