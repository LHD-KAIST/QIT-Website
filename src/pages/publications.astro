---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import PublicationItem from '../components/PublicationItem.astro';
import TagChip from '../components/TagChip.astro';
import { getPublications, getAreaTags, getKeywordTags, getTags, getTagCounts, getYears } from '../lib/collections';

const pubs = await getPublications();
const areas = await getAreaTags();
const keywords = await getKeywordTags();
const tags = await getTags();
const counts = await getTagCounts();
const years = await getYears();
const tagLabels = new Map(tags.map((t) => [t.id, t.label]));

const byYear = years.map((y) => ({
  year: y,
  items: pubs.filter((p) => p.year === y),
}));
---

<Base
  title="Publications"
  current="publications"
  description="Every paper the Quantum Information Theory group has authored, newest first — filterable by research area and keyword."
>
  <PageHeader
    title="Publications"
    lead="Every paper the group has authored, newest first. Filter by topic below."
  />

  <div class="wrap pubs" data-pub-filter>
    {/* ── filter chips ──────────────────────────────────────────────── */}
    <div class="filter">
      <div class="filter__row">
        <span class="filter__label">Research areas</span>
        <div class="chips">
          {
            areas.map((t) => (
              <TagChip
                id={t.id}
                label={t.label}
                count={counts.get(t.id) ?? 0}
                isArea
                href={`/publications?tag=${t.id}`}
              />
            ))
          }
        </div>
      </div>
      <div class="filter__row">
        <span class="filter__label">Keywords</span>
        <div class="chips">
          {
            keywords.map((t) => (
              <TagChip
                id={t.id}
                label={t.label}
                count={counts.get(t.id) ?? 0}
                href={`/publications?tag=${t.id}`}
              />
            ))
          }
        </div>
      </div>
    </div>

    {/* ── status + type toggle ──────────────────────────────────────── */}
    <div class="statusbar">
      <div class="statusbar__left" data-status>
        <span data-status-text>All papers, newest first</span>
        <button type="button" class="clearbtn" data-clear hidden>Clear filter ×</button>
      </div>
      <div class="typeseg" role="group" aria-label="Filter by type">
        <button type="button" class="typeseg__btn is-active" data-type-btn data-type="all" aria-pressed="true">All</button>
        <button type="button" class="typeseg__btn" data-type-btn data-type="journal" aria-pressed="false">Journal</button>
        <button type="button" class="typeseg__btn" data-type-btn data-type="preprint" aria-pressed="false">Preprint</button>
      </div>
    </div>

    {/* ── year groups ───────────────────────────────────────────────── */}
    <div class="years">
      {
        byYear.map(({ year, items }) => (
          <div class="yeargroup" data-year-group data-year={year}>
            <div class="year">
              <span class="year__num">{year}</span>
              <span
                class="year__fringe"
                data-year-ticks
                aria-label={`${items.length} paper${items.length === 1 ? '' : 's'} in ${year}`}
              >
                {items.map(() => (
                  <span class="tick" aria-hidden="true" />
                ))}
              </span>
            </div>
            <div>
              {items.map((p) => (
                <PublicationItem pub={p} tagLabels={tagLabels} />
              ))}
            </div>
          </div>
        ))
      }
      <div class="empty" data-empty hidden>
        No papers match this combination.{' '}
        <button type="button" class="empty__clear" data-clear-inline>Clear the filter.</button>
      </div>
    </div>
  </div>

  <script>
    import '../scripts/pub-filter.ts';
  </script>
</Base>

<style>
  .pubs {
    padding-top: 40px;
  }
  .filter {
    border-top: 1px solid var(--rule);
    padding-top: 24px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .filter__label {
    display: block;
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 12px;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .statusbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-top: 28px;
    padding: 16px 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    flex-wrap: wrap;
  }
  .statusbar__left {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 32px;
    font-family: var(--font-display);
    font-size: 14px;
    color: var(--ink);
  }
  .statusbar__left :global([data-status-text]) {
    color: var(--muted);
  }
  .statusbar__left :global([data-status-text] strong) {
    color: var(--ink);
    font-weight: 600;
  }
  .statusbar__left :global([data-status-text] em) {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--ink);
  }
  .clearbtn {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--note-ink);
    background: transparent;
    border: 1px solid var(--note-line);
    border-radius: var(--radius-chip);
    padding: 6px 9px;
    min-height: 32px;
    cursor: pointer;
  }
  .clearbtn:hover {
    border-color: var(--core);
  }

  .typeseg {
    display: flex;
    border: 1px solid var(--rule);
    border-radius: var(--radius-chip);
    overflow: hidden;
  }
  .typeseg__btn {
    font-family: var(--font-display);
    font-size: 12.5px;
    padding: 8px 14px;
    min-height: 32px;
    background: var(--pane);
    color: var(--ink);
    border: 0;
    border-left: 1px solid var(--rule);
    cursor: pointer;
  }
  .typeseg__btn:first-child {
    border-left: 0;
  }
  .typeseg__btn:hover {
    background: var(--cyan-bg-hover);
    color: var(--cyan-ink);
  }
  .typeseg__btn.is-active {
    background: var(--cyan);
    color: var(--pane);
  }

  .year {
    display: flex;
    align-items: flex-end;
    gap: 20px;
    margin-bottom: 4px;
  }
  .yeargroup {
    padding-top: 52px;
  }
  .year__num {
    font-family: var(--font-display);
    font-size: 34px;
    font-weight: 300;
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--ink);
    min-width: 116px;
  }
  .year__fringe {
    display: inline-flex;
    gap: 3px;
    align-items: flex-end;
    padding-bottom: 5px;
  }
  .tick {
    width: 1px;
    height: 18px;
    background: var(--cyan);
    display: block;
  }

  .empty {
    padding: 64px 0;
    font-family: var(--font-display);
    font-size: 15px;
    color: var(--muted);
  }
  .empty__clear {
    font-family: var(--font-display);
    font-size: 15px;
    color: var(--cyan);
    background: transparent;
    border: 0;
    border-bottom: 1px solid color-mix(in srgb, var(--cyan) 40%, transparent);
    cursor: pointer;
    padding: 0;
  }

  @media (max-width: 640px) {
    .year__num {
      font-size: 26px;
      min-width: 72px;
    }
  }
</style>
