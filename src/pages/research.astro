---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import ResearchAreaBlock from '../components/ResearchAreaBlock.astro';
import { getAreaTags } from '../lib/collections';

const areas = await getAreaTags();
---

<Base
  title="Research Topics"
  current="research"
  description="Three research directions — quantum learning, NISQ devices, and quantum metrology — mapping the boundary between quantum and classical."
>
  <PageHeader title="Research Topics" />

  <div class="wrap research">
    {
      areas.map((a, i) => (
        <ResearchAreaBlock area={a} figureLeft={i % 2 === 0} />
      ))
    }
  </div>
</Base>

<style>
  .research {
    padding-top: 8px;
    padding-bottom: 24px;
  }
</style>
